# Environnement: cluster k3s on-premise (namespaces g4-dev / g4-prod).
#
# Ce contenu va dans le secret ENV_FILE_CONTENTS des Environments GitHub
# `onprem-dev` et `onprem-prod`. scripts/k8s-apply.sh le transforme en
# secret Kubernetes `g4-env`, que tous les composants consomment via
# envFrom. Rien de tout ceci n'est commité.
#
# ── Différence unique avec envs/onprem.env.example (chemin Compose) ──
# Les noms d'hôtes internes prennent un TIRET, pas un underscore :
# g4-db, g4-kafka, g4-api. Un underscore est interdit dans un nom DNS
# (RFC 1123) : sous Compose ce sont des alias réseau Docker, qui le
# tolèrent ; dans Kubernetes ce sont de vrais Services, qui ne le
# tolèrent pas. C'est la seule adaptation à faire en reprenant un .env
# existant.

POSTGRES_USER=g4_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=g4_db
DATABASE_URL=postgres://g4_app:change_me@g4-db:5432/g4_db

KAFKA_BROKERS=g4-kafka:9092
API_URL=http://g4-api:3000

# Supervision — mot de passe admin de Grafana (lu par la clé
# GRAFANA_ADMIN_PASSWORD du secret g4-env).
GRAFANA_ADMIN_PASSWORD=change_me

# Sauvegarde chiffrée vers Azure Blob (CronJob g4-db-backup).
# Utiliser un chemin de dépôt distinct par stage.
RESTIC_REPOSITORY=azure:g4-backups:/restic-dev
RESTIC_PASSWORD=change_me_backup_passphrase
AZURE_ACCOUNT_NAME=change_me
AZURE_ACCOUNT_KEY=change_me
