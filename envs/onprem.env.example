# Environnement: on-premise (serveur partagé)
# Contenu à mettre dans le secret GitHub ENV_FILE_CONTENTS de
# l'environnement "onprem" (Settings > Environments), pas dans un .env
# commité.

POSTGRES_USER=g4_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=g4_db
DATABASE_URL=postgres://g4_app:change_me@g4_db:5432/g4_db

KAFKA_BROKERS=g4_kafka:9092
API_URL=http://g4_api:3000
DASHBOARD_PORT=8080

RESTIC_REPOSITORY=azure:g4-backups:/restic
RESTIC_PASSWORD=change_me_backup_passphrase
AZURE_ACCOUNT_NAME=change_me
AZURE_ACCOUNT_KEY=change_me
