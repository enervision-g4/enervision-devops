# Environnement: on-premise (serveur partagé)
# Contenu à mettre dans le secret GitHub ENV_FILE_CONTENTS de l'environnement
# "onprem-dev" ou "onprem-prod" (Settings > Environments), pas dans un .env
# commité. Un secret DISTINCT par stage, avec des valeurs DISTINCTES
# (mots de passe, JWT, port) — ne pas réutiliser les mêmes entre dev et prod.
#
# IMPORTANT : DATABASE_URL doit pointer sur "g4_db_dev" ou "g4_db_prod"
# (le nom réel du conteneur BDD, résolu via le DNS du réseau g4_net),
# pas juste "g4_db" — remplacer <STAGE> ci-dessous par "dev" ou "prod"
# selon l'environnement cible.

POSTGRES_USER=g4_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=g4_db
DATABASE_URL=postgres://g4_app:change_me@g4_db_<STAGE>:5432/g4_db

# --- API (authentification) ---
JWT_SECRET_KEY=change_me
API_USERNAME=admin
API_PASSWORD_HASH=change_me
# Port hôte sur lequel l'API est publiée directement (pas de Traefik, celui
# du serveur appartient à un autre groupe) — distinct par stage, retenu pour
# ce projet : 3001 pour dev, 3002 pour prod. Vérifier qu'il est libre avant
# utilisation : ss -tlnp | grep LISTEN  ou  docker ps --format '{{.Names}}: {{.Ports}}'
API_PORT=change_me

# Le dashboard est un SPA statique servi par nginx : c'est le NAVIGATEUR du
# client qui appelle cette URL en JS (window.APP_CONFIG.API_URL, injecté par
# docker/entrypoint.sh — voir enervision-dashboard/src/api/client.js). Elle
# doit donc être joignable depuis l'extérieur du serveur, PAS l'alias Docker
# interne "g4_api" (résolu seulement dans g4_net) ni le port interne du
# conteneur (3000) : adresse (ou nom) qui résout vers le serveur depuis le
# poste de qui ouvre le dashboard + le port HÔTE réellement publié pour ce
# stage, c'est-à-dire la même valeur que API_PORT ci-dessus.
#
# Pas de DNS pour ce serveur (juste une IP fournie par le formateur) : un nom
# en .local ne fonctionnera PAS de façon fiable ici. .local est réservé à la
# résolution mDNS/Bonjour (RFC 6762), pas au DNS classique — ça ne traverse
# généralement pas les sous-réseaux/VLAN, et Windows ne le résout pas nativement
# (il faut Bonjour installé). Risqué pour une démo avec des postes qu'on ne
# maîtrise pas (client pilote, investisseurs). Deux options fiables :
#   1. Utiliser directement l'IP:port (le plus sûr, fonctionne partout où le
#      serveur est joignable) : http://<IP_DU_SERVEUR>:3001 (dev) / :3002 (prod)
#   2. Pour un nom plus présentable UNIQUEMENT sur le poste qui présente la
#      démo : ajouter une entrée dans son fichier hosts local
#      (/etc/hosts ou C:\Windows\System32\drivers\etc\hosts) qui mappe
#      dev.dashboard-g4.local / prod.dashboard-g4.local vers l'IP du serveur.
#      Ne résout que sur cette machine précise, pas pour un visiteur externe.
API_URL=http://change_me_ip_ou_nom_qui_resout_vers_le_serveur:change_me_meme_valeur_que_API_PORT
# Comme API_PORT, doit être DISTINCT par stage (dev et prod tournent sur le
# même hôte Docker — voir le commentaire de deploy.yml) : ex. 8080 pour dev,
# 8081 pour prod.
DASHBOARD_PORT=change_me

# --- Grafana ---
# Dashboards de visualisation branches directement sur TimescaleDB (datasource
# PostgreSQL de Grafana). Le port hote doit lui aussi etre DISTINCT par stage
# (dev et prod sur le meme hote Docker) : ex. 8082 pour dev, 8083 pour prod.
GRAFANA_PORT=change_me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

RESTIC_REPOSITORY=azure:g4-backups:/restic
RESTIC_PASSWORD=change_me_backup_passphrase
AZURE_ACCOUNT_NAME=change_me
AZURE_ACCOUNT_KEY=change_me

# --- Collecteur ETL ---
API_MOCK_BASE_URL=http://change_me:8000
ETL_SITES=ALL
ETL_POLL_INTERVAL_SECONDS=60
ETL_SITE_REFRESH_INTERVAL_SECONDS=3600
# stdout pour derouler la chaine sans broker, kafka pour publier reellement.
ETL_PUBLISHER_TARGET=kafka

# --- Bus de messages et consumers ---
# Le nom d'hote est celui du conteneur declare dans compose/kafka.yml : les deux
# doivent rester synchronises.
KAFKA_BROKERS=g4_kafka:9092
# KAFKA_CONSUMER_GROUP est volontairement absent : chaque consumer a son propre
# defaut. Le renseigner ici mettrait les deux services dans le meme groupe, ou ils se
# partageraient le topic des sites au lieu de le recevoir chacun en entier.
CONSUMER_LOG_LEVEL=INFO
