# Environnement: OVH (utilisé si bascule complète ou partielle vers OVH)
# Contenu à mettre dans le secret GitHub ENV_FILE_CONTENTS de
# l'environnement "ovh".

POSTGRES_USER=g4_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=g4_db
DATABASE_URL=postgres://g4_app:change_me@g4_db:5432/g4_db

RESTIC_REPOSITORY=s3:https://s3.gra.io.cloud.ovh.net/g4-backups
RESTIC_PASSWORD=change_me_backup_passphrase
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me

# --- Collecteur ETL ---
API_MOCK_BASE_URL=http://change_me:8000
ETL_SITES=ALL
ETL_POLL_INTERVAL_SECONDS=60
ETL_SITE_REFRESH_INTERVAL_SECONDS=3600
# stdout pour derouler la chaine sans broker, kafka pour publier reellement.
ETL_PUBLISHER_TARGET=kafka

# --- Bus de messages et consumers ---
# Le nom d'hote est celui du conteneur declare dans compose/kafka.yml : les deux
# doivent rester synchronises.
KAFKA_BROKERS=g4_kafka:9092
# KAFKA_CONSUMER_GROUP est volontairement absent : chaque consumer a son propre
# defaut. Le renseigner ici mettrait les deux services dans le meme groupe, ou ils se
# partageraient le topic des sites au lieu de le recevoir chacun en entier.
CONSUMER_LOG_LEVEL=INFO
