# Environnement: Azure (VM dédiée, ex: service "ml")
# Contenu à mettre dans le secret GitHub ENV_FILE_CONTENTS de
# l'environnement "azure".

POSTGRES_USER=g4_app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=g4_db
DATABASE_URL=postgres://g4_app:change_me@g4_db_<STAGE>:5432/g4_db

RESTIC_REPOSITORY=azure:g4-backups:/restic
RESTIC_PASSWORD=change_me_backup_passphrase
AZURE_ACCOUNT_NAME=change_me
AZURE_ACCOUNT_KEY=change_me

# --- Collecteur ETL ---
API_MOCK_BASE_URL=http://change_me:8000
ETL_SITES=ALL
ETL_POLL_INTERVAL_SECONDS=60
ETL_SITE_REFRESH_INTERVAL_SECONDS=3600
# stdout pour derouler la chaine sans broker, kafka pour publier reellement.
ETL_PUBLISHER_TARGET=kafka
