# Managed by Ansible (site.yml). Do not edit on the host.
# Stage: {{ g4_stage }}
#
# Read by {{ g4_bin_dir }}/db-backup-to-azure.sh, and by the manual
# restore procedure (docs/cicd/backup-restore.md).
# Mode 0600, owned by root: outside the Git repository, out of reach of
# unprivileged accounts.
RESTIC_REPOSITORY={{ g4_restic_repository }}
RESTIC_PASSWORD={{ g4_restic_password }}
AZURE_ACCOUNT_NAME={{ g4_azure_account_name }}
AZURE_ACCOUNT_KEY={{ g4_azure_account_key }}
POSTGRES_USER={{ g4_postgres_user }}
POSTGRES_PASSWORD={{ g4_postgres_password }}
POSTGRES_DB={{ g4_postgres_db }}
PGHOST={{ g4_pghost }}
PGPORT={{ g4_pgport }}
DUMP_PATH=/tmp/g4_db.dump
BACKUP_TAG=g4-{{ g4_stage }}
